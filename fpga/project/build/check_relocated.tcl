# Open only, no hardware connection. Pass extracted delivery root as argv[0].
if {[llength $argv] != 1} {error "Expected relocated delivery directory"}
set root [file normalize [lindex $argv 0]]
open_project $root/vivado2023_project/roboarm_ila_rx_debug.xpr
set missing 0
set outside 0
foreach f [get_files -all] {
    set p [file normalize $f]
    if {![file exists $p]} {incr missing;puts "MISSING=$p"}
    if {![string match -nocase "$root/*" $p]} {incr outside;puts "OUTSIDE=$p"}
}
puts "RELOCATED_INPUT_MISSING=$missing INPUT_OUTSIDE=$outside"
if {$missing || $outside} {error "Relocated project has external or missing inputs"}
puts "RELOCATED_SOURCE_INPUTS_PASS; implementation outputs are regenerated by build_nodebug.tcl"
close_project
exit 0
